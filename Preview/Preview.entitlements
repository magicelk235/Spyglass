<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Quick Look preview extensions must be sandboxed to be activated by the
         system. Read-only access to the file being previewed, plus outgoing
         network for the optional Tier 1 (Drive PDF export) fetch. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.spyglass.shared</string>
    </array>
    <!-- Preview settings live in a JSON file the app writes here. macOS
         denies the extension reads of the App Group's preferences, so the
         group can't carry them. Read-only, this one folder. -->
    <key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
    <array>
        <string>/Library/Application Support/Spyglass/</string>
    </array>
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.spyglass.shared</string>
    </array>
</dict>
</plist>
